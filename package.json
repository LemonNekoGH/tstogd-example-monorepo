{
  "name": "tstogd-example-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "convert": "yarn workspace @tstogd-example/game convert",
    "typecheck": "yarn workspace @tstogd-example/game tsc -p tsconfig.json",
    "verify": "yarn convert && yarn typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "typescript-to-gdscript": "github:LemonNekoGH/typescript-to-gdscript#demo/external-package-sources"
  }
}
